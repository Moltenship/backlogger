{
  "name": "backlogger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:all": "concurrently -n app,convex -c cyan,magenta \"bun run dev\" \"bun run dev:convex\"",
    "dev:convex": "convex dev",
    "build": "tsgo -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint . --tsconfig tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "check": "bun run format:check && bun run typecheck && bun run lint"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@convex-dev/better-auth": "^0.12.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-router-ssr-query": "^1.166.9",
    "@tanstack/react-start": "^1.166.15",
    "@tanstack/router-plugin": "^1.166.13",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.37.0",
    "lucide-react": "^1.14.0",
    "nitro": "latest",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260503.1",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  }
}
